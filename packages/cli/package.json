{
  "name": "tiramisu",
  "version": "0.6.1",
  "description": "Git-native memory for AI coding agents",
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agents",
    "cli",
    "git",
    "markdown",
    "llm",
    "cursor",
    "claude",
    "codex",
    "antigravity",
    "opencode"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tiramisu": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "build": "bun scripts/build.mjs",
    "tiramisu": "bun run build && node ./dist/index.js",
    "format": "oxfmt --write src scripts",
    "test": "bun run build && bun test --isolate",
    "typecheck": "tsc --noEmit",
    "prepack": "bun scripts/build.mjs && bun scripts/readme.mjs copy",
    "postpack": "bun scripts/readme.mjs clean"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "add-mcp": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "jsonc-parser": "^3.3.1",
    "minisearch": "^7.2.0",
    "pg": "^8.23.0",
    "posthog-node": "^5.52.5",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@buildsip/file-utils": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "5.9.2"
  },
  "homepage": "https://github.com/buildsip/tiramisu#readme",
  "bugs": {
    "url": "https://github.com/buildsip/tiramisu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildsip/tiramisu.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
