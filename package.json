{
  "name": "tiramisu-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "tiramisu development workspace",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "release": "bun scripts/release.mjs",
    "audit": "bun audit",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "format": "oxfmt --write \"**/*.{ts,tsx,mjs,md}\"",
    "test": "bun run build && bun test --isolate",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "build": "bun run --filter ./packages/cli build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "fallow": "^2.85.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "5.9.2",
    "@types/bun": "^1.4.0"
  },
  "engines": {
    "node": ">=22.5.0",
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64",
    "esbuild"
  ]
}
